# Andersend has no root-level runtime env vars — each app owns its own local
# config file:
#
#   apps/api/.dev.vars.example        -> copy to apps/api/.dev.vars
#   apps/dashboard/.env.example       -> copy to apps/dashboard/.env (optional)
#
# This file documents the one variable external consumers of the SDK need,
# matching the example in README.md and the API Keys dashboard page.
ANDERSEND_API_KEY=and_dev_local
