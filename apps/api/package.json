{
  "name": "@andersseen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply andersend-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply andersend-db --env production --remote",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "api-key:create": "tsx scripts/create-api-key.ts"
  },
  "dependencies": {
    "@andersseen/contracts": "workspace:*",
    "@andersseen/database": "workspace:*",
    "@andersseen/email-core": "workspace:*",
    "@andersseen/email-templates": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@andersseen/eslint-config": "workspace:*",
    "@andersseen/typescript-config": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
