{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "declaration": false,
    "declarationMap": false
  }
}
